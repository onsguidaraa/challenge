# Server
PORT=3000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/student-learning-platform

# JWT (secrets must be at least 32 characters and different from each other)
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
# Format: <number><s|m|h|d>, e.g. 15m, 12h, 7d
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Learning DNA (profile.learnedStats) is recomputed at most once per user in this window
# (seconds) unless forced with POST /api/v1/profile/recompute. 0 = always recompute.
LEARNED_STATS_MIN_INTERVAL_SECONDS=300

# CORS (comma-separated list of allowed origins)
CORS_ORIGIN=http://localhost:5173
